// original function to populate dropdowns from data read from a CSV file
//*******************************************************
        function populateDropdowns(contents) {
            const rows = contents.split('\n').filter(row => row.trim() !== '');
            allData = rows.slice(1).map(row => {
                const cols = row.split(',');
                return {
                    siteLocation: cols[0].trim(),
                    country: cols[1].trim(),
                    lat: cols[2].trim(),
                    lon: cols[3].trim()
                };
            });

            const countries = [...new Set(allData.map(data => data.country))];
            countryDropdown.innerHTML = '<option value="">Select Country</option>';
            countries.forEach(country => {
                const option = document.createElement('option');
                option.value = country;
                option.textContent = country;
                countryDropdown.appendChild(option);
            });

            if (countries.includes('UK')) {
                countryDropdown.value = 'UK';
                filterSitesByCountry('UK');
            } else {
                filterSitesByCountry('');
            }

            populateDateDropdown();
            populateStartTimeDropdown();
            populateDurationDropdown();
            setDefaultsByCountryAndDate();
            populateThresholdDropdown(amberThresholdDropdown, 22);
            populateThresholdDropdown(redThresholdDropdown, 28);
        }

//*******************************************************
// function to populate dropdowns from data read from YAML file
//*******************************************************
function populateDropdownsFromYAML(yamlData) {
    // Log the structure of yamlData to diagnose the issue
	
    // Check if yamlData and yamlData.sites are properly defined
    if (!yamlData || !Array.isArray(yamlData.sites)) {
        console.error("Invalid YAML data structure:", yamlData);
        return;
    }

    // Proceed if the structure is valid
    allData = yamlData.sites.map(site => ({
        siteLocation: site.name,
        country: yamlData.country,
        lat: site.lat,
        lon: site.lng
    }));

    const countries = [...new Set(allData.map(data => data.country))];
    countryDropdown.innerHTML = '<option value="">Select Country</option>';
    countries.forEach(country => {
        const option = document.createElement('option');
        option.value = country;
        option.textContent = country;
        countryDropdown.appendChild(option);
    });

    if (countries.includes('UK')) {
        countryDropdown.value = 'UK';
        filterSitesByCountry('UK');
    } else {
        filterSitesByCountry('');
    }

    populateDateDropdown();
    populateStartTimeDropdown();
    populateDurationDropdown();
    setDefaultsByCountryAndDate();
    populateThresholdDropdown(amberThresholdDropdown, 22);
    populateThresholdDropdown(redThresholdDropdown, 28);
}

//*******************************************************
// filter sites by country
//*******************************************************
        function filterSitesByCountry(country) {
            const filteredData = allData.filter(data => data.country === country);
            siteDropdown.innerHTML = '<option value="">Select a Site</option>';
            filteredData.forEach(data => {
                const option = document.createElement('option');
                option.value = `${data.siteLocation},${data.country},${data.lat},${data.lon}`;
                option.textContent = `${data.siteLocation} (${data.country})`;
                siteDropdown.appendChild(option);
            });
        }
//*******************************************************
// populate date dropdown
//*******************************************************
        function populateDateDropdown() {
            const today = new Date();
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };

            dateDropdown.innerHTML = '<option value="">Select Date</option>';
            for (let i = -7; i <= 7; i++) {
                const date = new Date();
                date.setDate(today.getDate() + i);
                const option = document.createElement('option');
                option.value = date.toISOString().split('T')[0];
                option.textContent = date.toLocaleDateString('en-GB', options);
                dateDropdown.appendChild(option);
            }
            const defaultDate = new Date();
            defaultDate.setDate(today.getDate());
            dateDropdown.value = defaultDate.toISOString().split('T')[0];
        }
