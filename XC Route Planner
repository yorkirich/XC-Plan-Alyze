function displayMapWithRoute(turnpointsArray) {
    // Initialize the map with the base layer and overlay
    displayMapWithOverlay(turnpointsArray[0].dateTime, selectedType);

    // Add the turnpoints as markers and connect them with a polyline
    const latlngs = turnpointsArray.map(point => [point.latitude, point.longitude]);
    L.polyline(latlngs, { color: 'blue' }).addTo(map);

    turnpointsArray.forEach((point, index) => {
        const timeLabel = point.dateTime.split(', ')[1].split(':')[0];
        const isInitialRed = index === 0; // Check if this is the initial red marker
        const label = L.divIcon({
            className: 'text-label',
            html: `<div style="background-color: ${isInitialRed ? 'red' : 'blue'}; color: white; padding: 2px; border-radius: 3px;">${timeLabel}</div>`,
            iconSize: [20, 20] // Adjust as needed for better visibility
        });
        const markerOptions = {
            icon: label,
            draggable: false,
            riseOnHover: true
        };
        const marker = L.marker([point.latitude, point.longitude], markerOptions).addTo(map);

        // Add click event to marker
        marker.on('click', function () {
            if (previousRedMarker) {
                prevTimeLabel = previousRedMarker.marker.getElement().innerText;
                previousRedMarker.marker.setIcon(L.divIcon({
                    className: 'text-label',
                    html: `<div style="background-color: blue; color: white; padding: 2px; border-radius: 3px;">${prevTimeLabel}</div>`,
                    iconSize: [20, 20]
                }));
            }
            marker.setIcon(L.divIcon({
                className: 'text-label',
                html: `<div style="background-color: red; color: white; padding: 2px; border-radius: 3px;">${timeLabel}</div>`,
                iconSize: [20, 20]
            }));
            // Update the previousRedMarker reference
            previousRedMarker = { marker, point };
            displayOverlay(point.dateTime, selectedType);
        });

        // Set the initial previousRedMarker
        if (isInitialRed) {
            previousRedMarker = { marker, point };
        }
    });

    createOverlayControls();
    createOpacityControls();
}
