//*******************************************************
// get UTC offset
//*******************************************************
        function getUTCOffset() {
            const date = new Date();
            const offsetMinutes = date.getTimezoneOffset();
            const offsetHours = -offsetMinutes / 60; // Convert minutes to hours and negate since getTimezoneOffset() returns the offset in minutes with the opposite sign
            return offsetHours;
        }
//*******************************************************
// create XCsk file
//*******************************************************
        async function createXCTSKFile(routeForecast, launchSite, forecastModel, fileDate) {
            const documentsFolder = "XCTrack Routes/";
            const fileDateFormatted = new Date(fileDate).toISOString().split('T')[0];
            let qualifier = 1;
            let fileName = `Route ${fileDateFormatted} ${launchSite} ${forecastModel} @ ${new Date().toISOString().replace(/[:.]/g, '-')}.xctsk`;
            const jsonData = {
                taskType: "CLASSIC",
                version: 1,
                turnpoints: routeForecast.map((point, index) => ({
                    radius: 400,
                    waypoint: {
                        name: `FXC00${index}`,
                        lat: point.latitude,
                        lon: point.longitude,
                        altSmoothed: 0
                    }
                }))
            };
            const jsonString = JSON.stringify(jsonData, null, 4);
            const blob = new Blob([jsonString], { type: "application/json" });
            saveAs(blob, fileName);
// 	    console.log(`File '${fileName}' created successfully.`);
	        }
//*******************************************************
// calculate new location based on start point, wind direction adn speed
//*******************************************************
        async function calculateNewLocation(latitude, longitude, windSpeed, windDirection) {
            const distance = ((windSpeed * 0.8) + (2 / 3 * 38)) * 0.8;
            const windDirectionRad = (windDirection * Math.PI) / 180;
            const earthRadius = 6371;
            const latitudeRad = latitude * (Math.PI / 180);
            const longitudeRad = longitude * (Math.PI / 180);
            const newLatitudeRad = Math.asin(Math.sin(latitudeRad) * Math.cos(distance / earthRadius) +
                Math.cos(latitudeRad) * Math.sin(distance / earthRadius) * Math.cos(windDirectionRad));
            const newLongitudeRad = longitudeRad + Math.atan2(Math.sin(windDirectionRad) * Math.sin(distance / earthRadius) * Math.cos(latitudeRad),
                Math.cos(distance / earthRadius) - Math.sin(latitudeRad) * Math.sin(newLatitudeRad));
            const newLatitude = newLatitudeRad * (180 / Math.PI);
            const newLongitude = newLongitudeRad * (180 / Math.PI);            
            return { latitude: newLatitude, longitude: newLongitude };
        }
//*******************************************************
// function to gather the weather data for a specifc hour
//*******************************************************
function getWeatherDataForHour(weatherData, hour) {
    try {
        const hourIndex = weatherData.hourly.time.findIndex(time => {
            const weatherTime = new Date(time);
            return weatherTime.getUTCHours() === hour;
        });
        if (hourIndex === -1) {
            return null;
        }
        const windSpeed = weatherData.hourly.windspeed_850hPa[hourIndex];
        const windDirection = weatherData.hourly.winddirection_850hPa[hourIndex];
        if (windSpeed === undefined || windDirection === undefined) {
            return null;
        }
        return {
            windSpeed: windSpeed.toFixed(0),
            windDirection: windDirection
        };
    } catch (error) {
        console.error("Error fetching weather data for hour:", error);
        return null;
    }
}
