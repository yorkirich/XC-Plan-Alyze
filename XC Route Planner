function createDateTimeControls() {
    const dayIncrementButton = document.getElementById('dayIncrementButton');
    const dayDecrementButton = document.getElementById('dayDecrementButton');
    const hourIncrementButton = document.getElementById('hourIncrementButton');
    const hourDecrementButton = document.getElementById('hourDecrementButton');

