// function to determine URL of RASP image	
//****************************************
function getImageUrl(dateTime, type = 'S') {
    const [date, time] = dateTime.split(', ');
    const [day, month, year] = date.split('/').map(Number);
    const [hour, minute] = time.split(':').map(Number);
    const currentDate = new Date();
    const targetDate = new Date(year, month - 1, day);
    let dayDifference = Math.floor((targetDate - currentDate) / (1000 * 60 * 60 * 24)) + 1;
    let mapRes;
    let bounds;
    if (dayDifference < 3) {
        mapRes = "UK4";
        bounds = [[49.4, -11], [59.6, 2.78]];
    } else {
        mapRes = "UK12";
        bounds = [[48.83, -11.6], [59.75, 3.26]];
    }
    let dayString;
    if (dayDifference === 0) {
        dayString = mapRes;
    } else {
        dayString = `${mapRes}+${dayDifference}`;
    }
    let imageType;
    switch (type) {
        case 'N':
            imageType = 'sfcsunpct';
            break;
        case 'R':
            imageType = 'rain1';
            break;
        case 'C':
            imageType = 'zsfclclmask'; // Corrected the typo here
            break;
        case 'O':
            imageType = 'zblclmask';
            break;
        case 'W':
            imageType = 'blwind';
            break;
        case 'B':
            imageType = 'wblmaxmin';
            break;
        case 'S':
        default:
            imageType = 'stars';
            break;
    }
    const timeString = `${hour.toString().padStart(2, '0')}${minute.toString().padStart(2, '0')}lst`;
    const url = `https://cdn10.mrsap.org/${dayString}/FCST/${imageType}.curr.${timeString}.d2.body.png`;

//    if (dayString.startsWith('UK4+')) {
//        bounds = [[49.4, -11], [59.6, 2.78]];
//    } else {
//        bounds = [[48.83, -11.6], [59.75, 3.26]];
//    }
    console.log("Image url:", url, " Image Bounds:", bounds);
    return {
        url,
        bounds
    };
}
