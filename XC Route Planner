        incrementDay();
    });

    dayDecrementButton.addEventListener('click', () => {
        decrementDay();
    });

    hourIncrementButton.addEventListener('click', () => {
        incrementHour();
    });

    hourDecrementButton.addEventListener('click', () => {
        decrementHour();
    });
//****************************************
//
//****************************************
function incrementDay() {
    if (!previousRedMarker || !previousRedMarker.point || !previousRedMarker.point.dateTime) {
        console.error("Previous red marker or its datetime is not defined.");
        return;
    }

    const dateTime = previousRedMarker.point.dateTime;
    const [datePart, timePart] = dateTime.split(', ');
    const [day, month, year] = datePart.split('/').map(Number);
    const [hour, minute] = timePart.split(':').map(Number);

    const currentDate = new Date(year, month - 1, day, hour, minute);
    const newDate = new Date(currentDate.getTime() + 24 * 60 * 60 * 1000); // Increment by one day

    const newDay = newDate.getDate();
    const newMonth = newDate.getMonth() + 1; // January is 0, so we add 1
    const newYear = newDate.getFullYear();

    const formattedDate = `${newDay}/${newMonth}/${newYear}, ${hour}:${minute}`;
    updateDateTime(formattedDate);
}
//****************************************
//
//****************************************
function decrementDay() {
    if (!previousRedMarker || !previousRedMarker.point || !previousRedMarker.point.dateTime) {
        console.error("Previous red marker or its datetime is not defined.");
        return;
    }

    const dateTime = previousRedMarker.point.dateTime;
    const [datePart, timePart] = dateTime.split(', ');
    const [day, month, year] = datePart.split('/').map(Number);
    const [hour, minute] = timePart.split(':').map(Number);

    const currentDate = new Date(year, month - 1, day, hour, minute);
    const newDate = new Date(currentDate.getTime() - 24 * 60 * 60 * 1000); // Decrement by one day

    const newDay = newDate.getDate();
    const newMonth = newDate.getMonth() + 1; // January is 0, so we add 1
    const newYear = newDate.getFullYear();

    const formattedDate = `${newDay}/${newMonth}/${newYear}, ${hour}:${minute}`;
    updateDateTime(formattedDate);
}
//****************************************
//
//****************************************

    function incrementHour() {
        let currentTime = new Date(previousRedMarker.point.dateTime);
        currentTime.setHours(currentTime.getHours() + 1);
        updateDateTime(currentTime);
    }
//****************************************
//
//****************************************

    function decrementHour() {
        let currentTime = new Date(previousRedMarker.point.dateTime);
        currentTime.setHours(currentTime.getHours() - 1);
        updateDateTime(currentTime);
    }
//****************************************
//
//****************************************
function updateDateTime(newDateTimeStr) {
    let newDateTime = new Date(newDateTimeStr); 
    const newDate = `${newDateTime.getDate().toString().padStart(2, '0')}/${(newDateTime.getMonth() + 1).toString().padStart(2, '0')}/${newDateTime.getFullYear().toString().slice(-2)}`;
    const newTime = `${newDateTime.getHours().toString().padStart(2, '0')}:${newDateTime.getMinutes().toString().padStart(2, '0')}`;
    previousRedMarker.point.dateTime = `${newDate}, ${newTime}`;
    console.log("PRM Datetime after updateDateTime:", previousRedMarker.point.dateTime);
    displayMapWithOverlay(previousRedMarker.point.dateTime, selectedType);
}
