//*******************************************************
// set defauls by country and date (time of year)
//*******************************************************
        function setDefaultsByCountryAndDate() {
            const selectedCountry = countryDropdown.value;
            const selectedDate = new Date(dateDropdown.value);
            let defaultStartTime;
            let defaultDuration;
            if (selectedCountry === 'UK') {
                if (selectedDate.getMonth() >= 5 && selectedDate.getMonth() <= 7) {
                    defaultStartTime = "10:00";
                    defaultDuration = 9;
                } else {
                    defaultStartTime = "09:00";
                    defaultDuration = 7;
                }
            } else {
                defaultStartTime = "07:00";
                defaultDuration = 12;
            }
            startTimeDropdown.value = defaultStartTime;
            durationDropdown.value = defaultDuration;
        }
//*******************************************************
// get weather data
//*******************************************************
        async function getWeatherData(latitude, longitude, gWdateTime, model) {
            const url = `https://api.open-meteo.com/v1/${model}?latitude=${latitude}&longitude=${longitude}&hourly=windspeed_850hPa,winddirection_850hPa&start_date=${gWdateTime}&end_date=${gWdateTime}`;
            try {
                const response = await fetch(url);
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                const data = await response.json();
                return data;
            } catch (error) {
                console.error("Error fetching weather data:", error);
                return null;
            }
        }
