async function fetchYamlData(url) {
    try {
        const response = await fetch(url);
        const yamlText = await response.text();
        const data = jsyaml.load(yamlText);
        return data;
    } catch (error) {
        console.error('Error fetching YAML data:', error);
	console.log("Response:", response, " YAML text:",yamlText, " Data:", data);
    }
}
//****************************************
// function to display the RASP overlay
//****************************************
function displayOverlay(dateTime, selectedType) {
    // Remove the existing overlay
    if (overlay) {
        map.removeLayer(overlay);
    }
    // Get the new image URL and bounds for the overlay
    const image = getImageUrl(dateTime, selectedType);
    // Add the new overlay
    overlay = L.imageOverlay(image.url, image.bounds, { opacity: initialOpacity, interactive: true }).addTo(map);
}
//****************************************
// function to display map with overlay
//****************************************
function displayMapWithOverlay(dateTime, selectedType) {
    // Check if the map is already initialized
    console.log("IMwO Datetime:", dateTime);
    if (map) {
        map.remove(); // Remove the existing map instance
    }
    // Initialize the map with center to match the RASP overlay
    map = L.map('map').setView([51.0, -1.0], 6);
    // Set up the OpenStreetMap layer
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);
    // Apply the overlay
    displayOverlay(dateTime, selectedType);
}
