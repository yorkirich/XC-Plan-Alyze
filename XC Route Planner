        function handleCheckboxChange() {
            document.querySelectorAll('.overlay-controls input[type="checkbox"]').forEach(checkbox => {
                checkbox.addEventListener('change', function () {
                    if (this.checked) {
                        // Uncheck all other checkboxes
                        document.querySelectorAll('.overlay-controls input[type="checkbox"]').forEach(box => {
                            if (box !== this) box.checked = false;
                        });
			displayOverlay(previousRedMarker.point.dateTime, this.value);
                    }
                });
            });
        }
//****************************************
// function to create opacity controls
//****************************************
    function createOpacityControls() {
        const opacityControlsContainer = document.createElement('div');
        opacityControlsContainer.className = 'opacity-controls';
        const increaseButton = document.createElement('button');
        increaseButton.textContent = 'O+';
        increaseButton.addEventListener('click', () => {
            if (overlay) {
                let currentOpacity = overlay.options.opacity;
                currentOpacity = Math.min(currentOpacity + 0.1, 1);
                overlay.setOpacity(currentOpacity);
            }
        });

        const decreaseButton = document.createElement('button');
        decreaseButton.textContent = 'O-';
        decreaseButton.addEventListener('click', () => {
            if (overlay) {
                let currentOpacity = overlay.options.opacity;
                currentOpacity = Math.max(currentOpacity - 0.1, 0);
                overlay.setOpacity(currentOpacity);
            }
        });

        opacityControlsContainer.appendChild(increaseButton);
        opacityControlsContainer.appendChild(decreaseButton);

        document.getElementById('map').appendChild(opacityControlsContainer);
    }
//****************************************
// function to create overlay controls
//****************************************
    function createOverlayControls() {
        const overlayControlsContainer = document.createElement('div');
        overlayControlsContainer.className = 'overlay-controls';

        const overlays = ['S', 'N', 'R', 'C', 'O', 'W', 'B'];
        overlays.forEach(overlay => {
            const checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.id = `overlay-${overlay}`;
            checkbox.name = 'overlay';
            checkbox.value = overlay;
            checkbox.checked = (overlay === 'S'); // Default checked for S

            const label = document.createElement('label');
            label.htmlFor = `overlay-${overlay}`;
            label.textContent = overlay;

            overlayControlsContainer.appendChild(checkbox);
            overlayControlsContainer.appendChild(label);
        });

        document.getElementById('map').appendChild(overlayControlsContainer);
        handleCheckboxChange();

    }
